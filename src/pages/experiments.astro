---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/layout/SectionHeader.astro";
import { personNode, webPageNode } from "../components/seo/JsonLd.astro";
import { routes, SITE_URL } from "../data/links";
import { experiments, experimentsIntro, experimentsNote } from "../data/experiments";

const canonicalPath = routes.experiments;
const site = Astro.site ?? new URL(SITE_URL);

const description =
  "FlameMC and Apex: unreleased local experiments. Each one tests an idea or shows whether it is worth shipping.";

const jsonLd = [
  personNode(site),
  webPageNode(site, {
    name: "Experiments",
    description,
    path: canonicalPath,
    type: "CollectionPage",
  }),
];
---

<BaseLayout
  title="Experiments — LinsaFTW"
  description={description}
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
>
  <div class="w">
    <h1>Experiments.</h1>
    <p class="lead">{experimentsIntro}</p>

    <SectionHeader
      eyebrow="Experiments"
      id="lab"
      label="Unreleased"
    />

    <div class="g">
      {
        experiments.map((experiment) => (
          <div class="ex">
            <b>{experiment.name}</b>
            <span>{experiment.description}</span>
            <em>{experiment.category}</em>
            <i class="p">{experiment.status}</i>
          </div>
        ))
      }
    </div>

    <p class="note">{experimentsNote}</p>
    <p class="meta" style="margin-top:14px">
      There is no download, no changelog and no link — they were never released publicly.
    </p>
  </div>
</BaseLayout>
