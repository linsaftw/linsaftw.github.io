---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/layout/SectionHeader.astro";
import { personNode, webPageNode } from "../components/seo/JsonLd.astro";
import { links, routes, SITE_URL } from "../data/links";

const canonicalPath = routes.press;
const site = Astro.site ?? new URL(SITE_URL);

const description =
  "Public mentions, community posts and release notes for FlameWM, a Rust window manager for X11 with experimental Wayland support, by ArkFlame Studios. Community entries are links only.";

const jsonLd = [
  personNode(site),
  webPageNode(site, {
    name: "Press & community",
    description,
    path: canonicalPath,
    type: "CollectionPage",
  }),
];

type Mention = {
  title: string;
  source: string;
  date: string;
  link: string;
  takeaway: string;
};

const mentions: readonly Mention[] = [
  {
    title: "ArkFlame/FlameWM on Upstar",
    source: "Upstar, star tracker",
    date: "Snapshot undated; covers the 0.1.3 release of 30 October 2026",
    link: links.flamewmUpstar,
    takeaway:
      "A third-party tracker recorded 75 new stars in one week, about 18 times the usual pace. Its summary is machine-written.",
  },
];

const community: readonly Mention[] = [
  {
    title: "I use AI, so what? I made my free open source ...",
    source: "Reddit · r/foss",
    date: "stats not recorded",
    link: links.redditFoss,
    takeaway: "Link only. Reddit blocked automated fetches, so score and comment counts are not recorded here.",
  },
  {
    title: "Guia completa agentes harness modelos prompt",
    source: "Reddit · r/devsarg",
    date: "stats not recorded",
    link: links.redditGuide,
    takeaway: "Original post for the AI agents guide (Spanish). Link only; score and comment counts are not recorded.",
  },
];

const releases: readonly Mention[] = [
  {
    title: "FlameWM 0.1.5",
    source: "GitHub releases",
    date: "4 November 2026",
    link: links.flamewmReleases,
    takeaway: "Fixes glibc support for antiX 23 (Debian 12) and adds a backlight on-screen display.",
  },
  {
    title: "FlameWM 0.1.4",
    source: "GitHub releases",
    date: "4 November 2026",
    link: links.flamewmReleases,
    takeaway: "Visual bug fixes and several small desktop behaviors carried over from KDE.",
  },
];
---

<BaseLayout
  title="Press & community — LinsaFTW"
  description={description}
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
>
  <div class="w press">
    <h1>Press &amp; community.</h1>
    <p class="lead">
      Mentions of FlameWM that I could open and check, plus Reddit posts. Each entry links to its source.
    </p>

    <SectionHeader eyebrow="Mentions" id="mentions" label="Outside the repository" />

    <div class="g">
      {
        mentions.map((item) => (
          <div class="ex">
            <b>
              <a href={item.link} target="_blank" rel="noopener noreferrer">
                {item.title} &#8599;
              </a>
            </b>
            <span>{item.source} · {item.date}</span>
            <span>{item.takeaway}</span>
          </div>
        ))
      }
      <div class="ex ex-note">
        <b>How entries are checked</b>
        <span>Rule</span>
        <span>A mention is listed only when I opened the source and confirmed it. Trackers and summaries are reported as they are, with their own caveats.</span>
      </div>
    </div>

    <SectionHeader eyebrow="Community" id="community" label="Reddit posts" />

    <div class="g">
      {
        community.map((item) => (
          <div class="ex">
            <b>
              <a href={item.link} target="_blank" rel="noopener noreferrer">
                {item.title} &#8599;
              </a>
            </b>
            <span>{item.source} · {item.date}</span>
            <span>{item.takeaway}</span>
          </div>
        ))
      }
    </div>

    <SectionHeader eyebrow="Releases" id="releases" label="Recent source releases" />

    <div class="g">
      {
        releases.map((item) => (
          <div class="ex">
            <b>
              <a href={item.link} target="_blank" rel="noopener noreferrer">
                {item.title} &#8599;
              </a>
            </b>
            <span>{item.source} · {item.date}</span>
            <span>{item.takeaway}</span>
          </div>
        ))
      }
    </div>

    <p class="press-foot">
      Case study: <a href="/work/flamewm.html">FlameWM</a>. Source: <a href={links.flamewmGithub} target="_blank" rel="noopener noreferrer">GitHub &#8599;</a>.
    </p>
  </div>
</BaseLayout>

<style>
  .press-foot {
    margin: 24px 0 0;
    padding-top: 16px;
    border-top: 1px solid var(--ln, rgba(255, 255, 255, 0.12));
    color: var(--mu);
    font-size: 13px;
  }

  .press .ex-note b {
    color: var(--mu);
  }

  .press .ex-note {
    border-style: dashed;
    background: transparent;
  }

  .press-foot a,
  .press .ex b a {
    color: var(--ac);
  }

  /* Each entry has three children (title, source and date, takeaway). The shared
     .ex grid has four columns, which squeezed the takeaway; stack the entry instead. */
  .press .g {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
  }

  .press .ex {
    grid-template-columns: minmax(0, 1fr);
    gap: 8px;
    padding: 20px 22px;
    align-items: start;
  }

  .press .ex b {
    font-size: 16px;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .press .ex span {
    font-size: 13px;
    line-height: 1.55;
    color: var(--mu);
  }

  .press .ex span:first-of-type {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--mu-dim);
  }

  .press .ex:hover {
    background: var(--p2);
  }

  .press .ex a:focus-visible,
  .press-foot a:focus-visible {
    outline: 2px solid var(--ac);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .press .ex {
      transition: background 0.18s ease;
    }
  }
</style>
