---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/layout/SectionHeader.astro";
import { personNode, webPageNode } from "../components/seo/JsonLd.astro";
import { routes, SITE_URL, workPath } from "../data/links";
import { projects } from "../data/projects";

const canonicalPath = routes.ai;
const site = Astro.site ?? new URL(SITE_URL);

const description =
  "ARK AI, an AI provider and experimentation platform, and FAUS Legal, AI-assisted legal research and case organization for Argentine legal work.";

const byId = (id: string) => {
  const found = projects.find((p) => p.id === id);
  if (!found) throw new Error(`projects.ts is missing "${id}"`);
  return found;
};

const arkAi = byId("ark-ai");
const arkAiImage = arkAi.image;
if (!arkAiImage) throw new Error('projects.ts is missing an image for "ark-ai"');

const faus = byId("faus-legal");
if (!faus.disclaimer) throw new Error('projects.ts is missing the disclaimer for "faus-legal"');

const fairplay = byId("fairplay");

const jsonLd = [
  personNode(site),
  webPageNode(site, {
    name: "AI",
    description,
    path: canonicalPath,
    type: "CollectionPage",
  }),
];
---

<BaseLayout
  title="AI — LinsaFTW"
  description={description}
  canonicalPath={canonicalPath}
  ogImage="/images/og/work-ark-ai.webp"
  jsonLd={jsonLd}
>
  <div class="w">
    <h1>I make <em>AI systems.</em></h1>
    <p class="lead">
      Two AI products, plus the machine-learning workflows inside FairPlay.
    </p>

    <SectionHeader eyebrow="AI systems" id="ai" label="Providers · Legal research · Detection" />

    <div class="pl">
      <a class="pc" href={workPath(arkAi.id)}>
        <img
          src={arkAiImage}
          alt="ARK AI artwork"
          width="720"
          height="378"
          loading="lazy"
          decoding="async"
        />
        <div class="t">
          <small>{arkAi.kind}</small>
          <h3>{arkAi.name}</h3>
          <p>{arkAi.description}</p>
          <span class="l">Read the case study &#8594;</span>
        </div>
      </a>

      <a class="pc" href={workPath(faus.id)}>
        <div class="t">
          <small>{faus.kind}</small>
          <h3>{faus.name}</h3>
          <p>{faus.description}</p>
          <span class="l">Read the case study &#8594;</span>
        </div>
      </a>
    </div>

    <p class="note">{faus.disclaimer}</p>

    <style>
      /* Keep both AI cards the same height; the text block takes the remaining space so the
         imageless FAUS card does not leave an empty hole beside ARK AI's artwork. */
      .pl .pc {
        display: flex;
        flex-direction: column;
      }
      .pl .pc .t {
        display: flex;
        flex-direction: column;
        gap: 10px;
        flex: 1;
      }
      .pl .pc .t .l {
        margin-top: auto;
      }
      /* Match the artwork's native 720x378 ratio so object-fit: contain does not letterbox it. */
      .pl .pc img {
        aspect-ratio: 720 / 378;
      }
      /* Cards without artwork get a wordmark panel at the same ratio so row heights match. */
      .pl .pc:not(:has(img))::before {
        content: "FAUS";
        display: grid;
        place-items: center;
        aspect-ratio: 720 / 378;
        border-bottom: 1px solid var(--bd);
        background:
          radial-gradient(ellipse at 30% 20%, rgba(255, 107, 53, 0.16), transparent 60%),
          var(--shell2);
        color: var(--tx);
        font-size: clamp(2rem, 6vw, 3.4rem);
        font-weight: 800;
        letter-spacing: 0.12em;
      }
      .pl .pc:focus-visible {
        outline: 2px solid var(--ac);
        outline-offset: 3px;
      }
      .pl .pc:hover {
        background: var(--p2);
      }
      @media (prefers-reduced-motion: no-preference) {
        .pl .pc {
          transition: background 0.18s ease;
        }
      }
    </style>

    <SectionHeader eyebrow="Guide" id="guide" label="Agents · Harness · Models · Prompts" />

    <div class="g">
      <a class="c" href={routes.guide}>
        <small>Guide</small>
        <h3>How I set up AI coding agents</h3>
        <p>
          Skills, AGENTS.md, harnesses, subscriptions, model choice and MCP servers, summarized from
          a Spanish-language guide.
        </p>
        <span class="l">Read the guide &#8594;</span>
      </a>
    </div>

    <SectionHeader
      eyebrow="Inside FairPlay"
      id="fairplay"
      label="Not a separate AI product"
    />

    <div class="g">
      <div class="c">
        <small>{fairplay.kind}</small>
        <h3>{fairplay.name}</h3>
        <p>{fairplay.description}</p>
        <p class="meta" style="margin-top:12px">
          Machine-learning workflows are a supporting part of FairPlay, my Minecraft anticheat, not
          a separate AI product.
        </p>
        <div class="chips" style="margin-top:14px">
          <a class="chip" href={fairplay.url} target="_blank" rel="noopener noreferrer">
            FairPlay on BuiltByBit ↗
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
