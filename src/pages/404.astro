---
import BaseLayout from "../layouts/BaseLayout.astro";
import { routes } from "../data/links";

const canonicalPath = routes.notFound;
const description = "The page you asked for does not exist.";
---

<BaseLayout
  title="Not found — LinsaFTW"
  description={description}
  canonicalPath={canonicalPath}
  noindex
>
  <div class="w">
    <h1>Not <em>found.</em></h1>
    <p class="lead">
      That page does not exist. It may have moved, or it may never have existed.
    </p>
    <div class="chips">
      <a class="chip hot" href={routes.home}>Home</a>
      <a class="chip" href={routes.articles}>Articles</a>
    </div>
  </div>
</BaseLayout>
