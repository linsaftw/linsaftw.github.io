---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/layout/SectionHeader.astro";
import { personNode, webPageNode } from "../components/seo/JsonLd.astro";
import { links, routes, SITE_URL } from "../data/links";

const canonicalPath = routes.guide;
const site = Astro.site ?? new URL(SITE_URL);

const description =
  "A summary of a Spanish-language guide to AI coding agents: skills, AGENTS.md, harnesses, subscriptions, models, MCP servers, RTK and closing workflow advice. Summarized from a post by LinsaFTW.";

const redditUrl = links.redditGuide;
const articlePath = "/posts/guia-completa-agentes-harness-modelos-prompt.html";

const toc = [
  { id: "skills", label: "Skills" },
  { id: "agents-md", label: "AGENTS.md" },
  { id: "harness", label: "Harness" },
  { id: "subscriptions", label: "Subscriptions" },
  { id: "models", label: "Models" },
  { id: "mcp", label: "MCP servers" },
  { id: "rtk", label: "RTK" },
  { id: "closing", label: "Closing advice" },
];

const jsonLd = [
  personNode(site),
  webPageNode(site, {
    name: "AI agents guide",
    description,
    path: canonicalPath,
    type: "WebPage",
  }),
];
---

<BaseLayout
  title="AI agents guide — LinsaFTW"
  description={description}
  canonicalPath={canonicalPath}
  ogImage="/images/og/work-ark-ai.webp"
  jsonLd={jsonLd}
>
  <div class="w gd">
    <nav aria-label="Breadcrumb" class="meta gd-crumb">
      <a href="/ai.html">AI</a> <span aria-hidden="true">/</span> <span>Guide</span>
    </nav>

    <p class="gd-kicker">Summary in English of a Spanish guide</p>
    <h1 lang="es">[Guia Completa] Agentes, Harness, Modelos, Prompt Engineering y MCPs</h1>
    <p class="lead">
      Skills, AGENTS.md, harnesses and subscriptions, how to choose a model, which MCP servers
      help, and how to work with several agents at once.
    </p>
    <p class="meta">
      Original: <span lang="es">"[Guia Completa] Agentes, Harness, Modelos, Prompt Engineering y
      MCPs"</span>, posted on r/devsarg by u/LinsaFTW on 2026-11-06. Prices and recommendations are
      the author's views as of that date. Reddit score and comment counts are not shown because
      they were not verified.
    </p>

    <div class="chips gd-actions">
      <a class="chip hot" href={redditUrl} target="_blank" rel="noopener noreferrer">
        Read the original on Reddit ↗
      </a>
      <a class="chip" href={articlePath}>Read as article &#8594;</a>
    </div>

    <nav class="gd-toc" aria-labelledby="gd-toc-title">
      <h2 id="gd-toc-title">On this page</h2>
      <ol>
        {toc.map((item) => (
          <li><a href={`#${item.id}`}>{item.label}</a></li>
        ))}
      </ol>
    </nav>

    <section class="gd-section" aria-labelledby="skills">
      <SectionHeader eyebrow="Skills" id="skills" label="Useful and useless" />
      <div class="g">
        <div class="c">
          <small>Useful</small>
          <h3>ui-ux-pro-max and unslop</h3>
          <p>The author lists these two as useful examples.</p>
        </div>
        <div class="c">
          <small>Useless</small>
          <h3>Caveman, Ponytail, Superpowers</h3>
          <p>The author lists these three as useless examples.</p>
        </div>
        <div class="c">
          <small>Method</small>
          <h3>Turn repeated prompts into skills</h3>
          <p>
            Notice which prompts you repeat again and again, then create a skill for each one.
          </p>
        </div>
      </div>
    </section>

    <section class="gd-section" aria-labelledby="agents-md">
      <SectionHeader eyebrow="AGENTS.md" id="agents-md" label="Operating rules" />
      <div class="g">
        <div class="c">
          <small>Example</small>
          <h3>The lean-agents setup</h3>
          <p>
            The post refers to an earlier lean-agents example. Its prompts, and other instructions
            you can add to AGENTS.md, are shown as images, so this page does not reproduce them.
          </p>
        </div>
        <div class="c">
          <small>Mistakes</small>
          <h3>Record them in AGENTS.md</h3>
          <p>
            When an agent makes a mistake, document it and improve AGENTS.md so it does not repeat
            the mistake. See the closing advice below.
          </p>
        </div>
      </div>
    </section>

    <section class="gd-section" aria-labelledby="harness">
      <SectionHeader eyebrow="Harness" id="harness" label="What to avoid" />
      <div class="g">
        <div class="c">
          <small>Avoid</small>
          <h3>CommandCode</h3>
          <p>
            Saturates the context and does not orchestrate subagents well, even with the same
            model.
          </p>
        </div>
        <div class="c">
          <small>Avoid</small>
          <h3>Codex</h3>
          <p>Fills the context faster than other alternatives.</p>
        </div>
      </div>
    </section>

    <section class="gd-section" aria-labelledby="subscriptions">
      <SectionHeader eyebrow="Subscriptions" id="subscriptions" label="Prices as of 2026-11-06" />
      <p class="meta">
        The post writes "billones", which in Spanish means trillion. Check the token figures on each
        provider's page.
      </p>
      <div class="g">
        <div class="c">
          <small>OpenCode GO</small>
          <h3>$10 per month</h3>
          <p>8 billones of DeepSeek v4.1 tokens per month. The author calls it a beast.</p>
        </div>
        <div class="c">
          <small>OpenDesign GO</small>
          <h3>$10 per month</h3>
          <p>5 billones of DeepSeek v4.1 tokens per month. The author calls it good.</p>
        </div>
        <div class="c">
          <small>CommandCode GOAT</small>
          <h3>$10 per month</h3>
          <p>
            5 billones of DeepSeek v4.1 tokens per month. The author calls it good, although the
            post advises against the CommandCode harness.
          </p>
        </div>
        <div class="c">
          <small>Others</small>
          <h3>Xiaomi, Alibaba, Minimax, GLM, Kimi, and more</h3>
          <p>The author says they are all bad and should never be used.</p>
        </div>
      </div>
    </section>

    <section class="gd-section" aria-labelledby="models">
      <SectionHeader eyebrow="Models" id="models" label="Golden rule" />
      <p class="meta">The right model depends on the work. The post's rule of thumb:</p>
      <div class="g">
        <div class="c">
          <small>Claude</small>
          <h3>Backend and frontend</h3>
          <p>Sonnet 5.5 low with Haiku 5.5 low.</p>
        </div>
        <div class="c">
          <small>GPT</small>
          <h3>Backend and frontend</h3>
          <p>GPT 6 Luna MAX.</p>
        </div>
        <div class="c">
          <small>Everything else</small>
          <h3>Backend and frontend</h3>
          <p>DeepSeek v4.1 Flash, which the author says lasts all day.</p>
        </div>
      </div>
    </section>

    <section class="gd-section" aria-labelledby="mcp">
      <SectionHeader eyebrow="MCP servers" id="mcp" label="Best ones, per the post" />
      <div class="g">
        <div class="c">
          <small>Browser</small>
          <h3>chrome-devtools</h3>
          <p>Lets the agent interact with Chrome.</p>
        </div>
        <div class="c">
          <small>Search</small>
          <h3>exa</h3>
          <p>Online search when you need it.</p>
        </div>
        <div class="c">
          <small>Data</small>
          <h3>mongodb</h3>
          <p>Simpler interaction with real databases.</p>
        </div>
      </div>
    </section>

    <section class="gd-section" aria-labelledby="rtk">
      <SectionHeader eyebrow="RTK" id="rtk" label="RTK (no es lo mismo que RKT)" />
      <p>
        RTK is a tool in the author's own setup. It condenses command output to save tokens. It
        keeps every signal and drops the costly noise.
      </p>
      <ul>
        <li>Treat RTK output as the complete result.</li>
        <li>Run commands normally. Batch related commands into one call to avoid extra turns.</li>
        <li>A truncated result states its recovery path.</li>
        <li>
          Re-run a command as <code>rtk bypass &lt;cmd&gt;</code> only when the result is unusable:
          empty when output was clearly expected, contradicting its exit code, or garbled.
        </li>
      </ul>
    </section>

    <section class="gd-section" aria-labelledby="closing">
      <SectionHeader eyebrow="Closing advice" id="closing" label="Work with several agents" />
      <ol class="gd-takeaways">
        <li>
          <strong>Do not be lazy.</strong> While an agent works, start on the next task and prepare
          it.
        </li>
        <li>
          <strong>Run multiple subagents and use virtual desktops.</strong> The post's example is a
          two-row indicator in the KDE Plasma taskbar for switching between agents quickly.
        </li>
        <li>
          <strong>Keep agents organized</strong> with two lists, "running" and "pending". Read what
          they write.
        </li>
        <li>
          <strong>Do not accept "done" on its own.</strong> Read the pros and cons, or whether the
          work is partial, and check how it turned out.
        </li>
        <li>
          <strong>Document agent mistakes</strong> and improve AGENTS.md so the agent does not repeat
          them.
        </li>
      </ol>
      <p class="meta">
        The author calls it the first guide they have written and asks readers to add corrections,
        mini-guides and missed points in the comments.
      </p>
    </section>

    <p class="note">
      Summary of a community post. Prices, model names and recommendations are the author's views
      as of 2026-11-06.
      <a href={redditUrl} target="_blank" rel="noopener noreferrer">Read the original ↗</a>
    </p>
  </div>
</BaseLayout>

<style>
  .gd-crumb {
    margin-bottom: 12px;
  }
  .gd-crumb a {
    color: var(--mu);
  }
  .gd-actions {
    margin-top: 18px;
  }
  .gd-toc {
    margin: 32px 0 8px;
    padding: 20px 22px;
    border: 1px solid var(--bd);
    background: var(--p);
  }
  .gd-toc h2 {
    margin: 0 0 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mu);
  }
  .gd-toc ol {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 2px 18px;
  }
  .gd-toc a {
    display: inline-block;
    min-height: 44px;
    line-height: 44px;
    color: var(--tx);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .gd-toc a:hover,
  .gd-toc a:focus-visible {
    color: var(--ac);
    border-bottom-color: var(--ac);
  }
  .gd-section {
    margin-top: 56px;
  }
  .gd-takeaways {
    margin: 0;
    padding: 0 0 0 1.5em;
    display: grid;
    gap: 10px;
    color: var(--copy);
  }
  .gd a:focus-visible {
    outline: 2px solid var(--ac);
    outline-offset: 3px;
  }
  .gd-kicker {
    margin: 0 0 12px;
    color: var(--ac);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .gd h1 {
    font-size: clamp(26px, 4.2vw, 40px);
    line-height: 1.15;
    overflow-wrap: anywhere;
  }
  .gd-section ul {
    margin: 0;
    padding: 0 0 0 1.25em;
    list-style: disc;
    display: grid;
    gap: 10px;
    color: var(--copy);
    line-height: 1.6;
  }
  .gd-section p {
    max-width: 68ch;
    line-height: 1.6;
  }
  .gd code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--ac);
    background: var(--p2);
    border: 1px solid var(--bd);
    padding: 1px 6px;
    overflow-wrap: anywhere;
  }
  .gd-section li > code,
  .gd-section p > code {
    white-space: nowrap;
  }
  @media (max-width: 760px) {
    .gd-section li > code,
    .gd-section p > code {
      white-space: normal;
    }
    .gd-toc ol {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .gd-toc a {
      transition: color 0.18s ease, border-color 0.18s ease;
    }
  }
</style>
