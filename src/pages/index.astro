---
import BaseLayout from "../layouts/BaseLayout.astro";
import { homeGraph } from "../components/seo/JsonLd.astro";
import IdentityHero from "../components/home/IdentityHero.astro";
import TerminalBlock from "../components/home/TerminalBlock.astro";
import ProjectFeature from "../components/home/ProjectFeature.astro";
import FounderBridge from "../components/home/FounderBridge.astro";
import WorkProcess from "../components/home/WorkProcess.astro";
import GameFeature from "../components/home/GameFeature.astro";
import AiFeature from "../components/home/AiFeature.astro";
import ExperimentRow from "../components/home/ExperimentRow.astro";
import Timeline from "../components/home/Timeline.astro";

import {
  identity,
  identityRow,
  homeDescription,
  homeH1,
  homeH1Accent,
  sections,
} from "../data/identity";
import { links, routes, SITE_URL } from "../data/links";
import { minecraftProjects } from "../data/projects";
import { experiments, experimentsNote } from "../data/experiments";

// C7 — exact homepage title and description.
const title = "LinsaFTW — Minecraft Infrastructure Developer";
const site = Astro.site ?? new URL(SITE_URL);
const jsonLd = homeGraph(site, { name: title, description: homeDescription });

// C16 — H1 is one sentence split so `<em>` carries the accent word only.
const h1Lead = homeH1.slice(0, homeH1.length - homeH1Accent.length);
const homeLead = `I design, build and ship server software, security systems, games and experimental AI products. Founder of ${identity.founderOf}.`;

// C3 — every chip href comes from links.ts and opens externally.
const badge = {
  src: "/images/badges/builtbybit-top-creator.webp",
  width: 300,
  height: 100,
  alt: "BuiltByBit creator badge",
};
interface Chip {
  readonly label: string;
  readonly href: string;
  readonly hot?: boolean;
  readonly badge?: boolean;
}

const chipRow1: readonly Chip[] = [
  { label: identity.founderOf, href: links.arkflame, hot: true },
  { label: "GitHub", href: links.github },
  { label: "BuiltByBit", href: links.bbbCreator, badge: true },
  { label: "YouTube", href: links.youtube },
];
const chipRow2: readonly Chip[] = [
  { label: "FlameCord", href: links.flamecord },
  { label: "ExploitFixer", href: links.exploitfix },
  { label: "VeloFlame", href: links.veloflame },
  { label: "FairPlay", href: links.fairplay },
];

// C16 — the four Minecraft products, in spec order.
const buildCards = minecraftProjects.filter((project) => project.featured);
---

<BaseLayout
  title={title}
  description={homeDescription}
  canonicalPath={routes.home}
  ogType="website"
  jsonLd={jsonLd}
  ogImage="/images/hero/early-computer.webp"
>
  <IdentityHero />

  <div class="w">
    <div class="id">
      <div class="av" role="img" aria-label="LinsaFTW portrait"></div>
      <small>{identityRow}</small>
    </div>

    <h1>{h1Lead}<em>{homeH1Accent}</em></h1>

    <p class="lead">{homeLead}</p>

    <div class="chips">
      {
        chipRow1.map((chip) => (
          <a
            class:list={["chip", chip.hot && "hot"]}
            href={chip.href}
            target="_blank"
            rel="noopener noreferrer"
          >
            {chip.label}
            {
              chip.badge && (
                <img
                  src={badge.src}
                  alt={badge.alt}
                  width={badge.width}
                  height={badge.height}
                  decoding="async"
                />
              )
            }
          </a>
        ))
      }
      {
        chipRow2.map((chip) => (
          <a class="chip" href={chip.href} target="_blank" rel="noopener noreferrer">
            {chip.label}
          </a>
        ))
      }
    </div>

    <TerminalBlock />

    <div class="sh" id={sections.build.id}>
      <h2>{sections.build.eyebrow}</h2>
      <span class="sh-right">
        <span>{sections.build.right}</span>
        <a class="sh-all" href={sections.build.viewAll}>View all →</a>
      </span>
    </div>
    <div class="pl">
      {buildCards.map((project) => <ProjectFeature project={project} />)}
    </div>

    <FounderBridge />

    <div class="sh" id={sections.how.id}>
      <h2>{sections.how.eyebrow}</h2>
      <span class="sh-right">
        <span>{sections.how.right}</span>
      </span>
    </div>
    <WorkProcess />

    <div class="sh" id={sections.games.id}>
      <h2>{sections.games.eyebrow}</h2>
      <span class="sh-right">
        <span>{sections.games.right}</span>
        <a class="sh-all" href={sections.games.viewAll}>View all →</a>
      </span>
    </div>
    <GameFeature />

    <div class="sh" id={sections.ai.id}>
      <h2>{sections.ai.eyebrow}</h2>
      <span class="sh-right">
        <span>{sections.ai.right}</span>
        <a class="sh-all" href={sections.ai.viewAll}>View all →</a>
      </span>
    </div>
    <AiFeature />

    <div class="sh" id={sections.lab.id}>
      <h2>{sections.lab.eyebrow}</h2>
      <span class="sh-right">
        <span>{sections.lab.right}</span>
        <a class="sh-all" href={sections.lab.viewAll}>View all →</a>
      </span>
    </div>
    <div class="g">
      {experiments.map((experiment) => <ExperimentRow experiment={experiment} />)}
    </div>
    <p class="note">{experimentsNote}</p>

    <div class="sh" id={sections.timeline.id}>
      <h2>{sections.timeline.eyebrow}</h2>
      <span class="sh-right">
        <span>{sections.timeline.right}</span>
      </span>
    </div>
    <Timeline />
  </div>
</BaseLayout>

<style>
  .sh h2 {
    color: var(--tx);
    font-weight: 700;
  }

  /* C10 — /images/profile/linsaftw.webp is 512x512 and the circle is 104px. */
  .av {
    --av: url("/images/profile/linsaftw.webp");
  }
</style>
