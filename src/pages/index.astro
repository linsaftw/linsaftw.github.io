---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { homeGraph } from "../components/seo/JsonLd.astro";
import IdentityHero from "../components/home/IdentityHero.astro";
import TerminalBlock from "../components/home/TerminalBlock.astro";
import ProjectFeature from "../components/home/ProjectFeature.astro";

import {
  identity,
  identityRow,
  homeDescription,
  homeH1,
  homeH1Accent,
} from "../data/identity";
import { postPath, links, routes, SITE_URL, workPath } from "../data/links";
import { projectById } from "../data/projects";
import { timeline } from "../data/timeline";

const title = "LinsaFTW — Minecraft Infrastructure Developer";
const site = Astro.site ?? new URL(SITE_URL);
const jsonLd = homeGraph(site, { name: title, description: homeDescription });

const h1Lead = homeH1.slice(0, homeH1.length - homeH1Accent.length);
const homeLead = `I design, build and ship server software, security systems, a Linux desktop, games and AI products. Founder of ${identity.founderOf}.`;

const featuredIds = ["exploitfixer", "flamewm", "veloflame", "ffaa-zombies"] as const;
const featured = featuredIds
  .map((id) => projectById(id))
  .filter((project): project is NonNullable<typeof project> => Boolean(project));

const alsoShipped = [
  "flamecord",
  "fairplay",
  "entitylimiter",
  "redstonelimiter",
  "flamespawners",
  "authmepremium",
  "ark-ai",
  "faus-legal",
]
  .map((id) => projectById(id))
  .filter((project): project is NonNullable<typeof project> => Boolean(project));

const recent = (await getCollection("articles"))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 4)
  .map((entry) => {
    const slug = /^\/posts\/(.+)\.html$/.exec(entry.data.canonicalPath)?.[1];
    if (!slug) throw new Error(`bad canonicalPath: ${entry.data.canonicalPath}`);
    return {
      title: entry.data.title,
      description: entry.data.description,
      href: postPath(slug),
      date: entry.data.publishedAt.toISOString().slice(0, 10),
      tags: entry.data.tags.slice(0, 3),
    };
  });

const beyond = [
  {
    eyebrow: "Game",
    title: "FFAA Zombies",
    text: "Browser-first co-op survival with large enemy counts, classes and custom maps.",
    href: workPath("ffaa-zombies"),
    link: "Play and read the brief",
  },
  {
    eyebrow: "AI",
    title: "ARK AI + FAUS Legal",
    text: "A canonical AI platform and a focused Argentine legal-research workspace.",
    href: workPath("ark-ai"),
    link: "Open ARK AI case study",
  },
  {
    eyebrow: "Experiments",
    title: "FlameMC + Apex",
    text: "Unpublished local experiments in asynchronous Paper work and anti-ESP detection.",
    href: routes.experiments,
    link: "See the experiments",
  },
] as const;
---

<BaseLayout
  title={title}
  description={homeDescription}
  canonicalPath={routes.home}
  ogType="website"
  jsonLd={jsonLd}
  ogImage="/images/og/home.webp"
  preloadImage="/images/hero/early-computer.webp"
>
  <IdentityHero />

  <div class="w">
    <div class="id">
      <div class="av" role="img" aria-label="LinsaFTW portrait"></div>
      <small>{identityRow}</small>
    </div>

    <h1>{h1Lead}<em>{homeH1Accent}</em></h1>

    <p class="lead">{homeLead}</p>

    <div class="chips home-ctas">
      <a class="chip hot" href={routes.work}>Explore selected work</a>
      <a class="chip" href={routes.articles}>Read technical articles</a>
      <a class="chip" href={routes.docs}>Documentation</a>
      <a class="chip" href={links.arkflame} target="_blank" rel="noopener noreferrer">
        ArkFlame Studios &#8599;
      </a>
      <a class="chip" href={links.github} target="_blank" rel="noopener noreferrer">
        GitHub &#8599;
      </a>
    </div>

    <TerminalBlock />

    <div class="sh" id="build">
      <h2>Selected work</h2>
      <span class="sh-right">
        <span>Evidence first</span>
        <a class="sh-all" href={routes.work}>All case studies &#8594;</a>
      </span>
    </div>
    <div class="pl" data-reveal>
      {featured.map((project) => <ProjectFeature project={project} />)}
    </div>

    <div class="also">
      <small>Also shipped</small>
      <div>
        {
          alsoShipped.map((project) => (
            <a href={workPath(project.id)}>
              {project.name} <span aria-hidden="true">&#8594;</span>
            </a>
          ))
        }
        <a href={links.arkflamePlugins} target="_blank" rel="noopener noreferrer">
          Full ArkFlame catalog &#8599;
        </a>
      </div>
    </div>

    <span id="how" class="legacy-anchor" aria-hidden="true"></span>
    <div class="sh" id="proof">
      <h2>Track record</h2>
      <span class="sh-right">
        <span>Selected milestones</span>
        <a class="sh-all" href={routes.about}>About the work &#8594;</a>
      </span>
    </div>
    <ol class="proof" id="timeline" data-reveal>
      {
        timeline.map((item, index) => (
          <li class={index === timeline.length - 1 ? "now" : undefined}>
            <b>{item.year}</b>
            <span>{item.text}</span>
          </li>
        ))
      }
    </ol>

    <div class="sh" id="writing">
      <h2>Recent writing</h2>
      <span class="sh-right">
        <span>Source-backed notes</span>
        <a class="sh-all" href={routes.articles}>All articles &#8594;</a>
      </span>
    </div>
    <div class="recent" data-reveal>
      {
        recent.map((article) => (
          <a class="recent-row" href={article.href}>
            <time datetime={article.date}>{article.date}</time>
            <div>
              <h3>{article.title}</h3>
              <p>{article.description}</p>
            </div>
            <span aria-hidden="true">&#8594;</span>
          </a>
        ))
      }
    </div>

    <span id="games" class="legacy-anchor" aria-hidden="true"></span>
    <span id="ai" class="legacy-anchor" aria-hidden="true"></span>
    <span id="lab" class="legacy-anchor" aria-hidden="true"></span>
    <div class="sh" id="beyond">
      <h2>Beyond Minecraft</h2>
      <span class="sh-right">
        <span>Games, AI and experiments</span>
      </span>
    </div>
    <div class="beyond" data-reveal>
      {
        beyond.map((item) => (
          <a href={item.href}>
            <small>{item.eyebrow}</small>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            <span>{item.link} &#8594;</span>
          </a>
        ))
      }
    </div>
    <div class="about-cta">
      <div>
        <h2>I build the parts users never see.</h2>
        <p>
          Proxies, packet checks, schedulers, storage and the support work that keeps them
          running. The case studies explain the decisions, not just the feature list.
        </p>
      </div>
      <a class="chip hot" href={routes.about}>Read the full story</a>
    </div>
  </div>
</BaseLayout>

<style>
  .home-ctas {
    margin-bottom: 8px;
  }

  .also {
    border: 1px solid var(--bd);
    background: var(--p);
    padding: 16px 18px;
    margin-top: 14px;
    display: flex;
    gap: 16px;
    align-items: baseline;
    flex-wrap: wrap;
  }

  .also small {
    color: var(--ac);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .also div {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
  }

  .also a {
    color: var(--mu);
    font-size: 12px;
  }

  .also a:hover {
    color: var(--ac);
  }

  .also a span {
    color: var(--ac);
  }

  .proof {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    border: 1px solid var(--bd);
    background: var(--bd);
    gap: 1px;
  }

  .proof li {
    background: var(--p);
    padding: 16px 14px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-height: 126px;
  }

  .proof li b {
    color: var(--tx);
    font-size: 18px;
  }

  .proof li span {
    color: var(--mu);
    font-size: 11px;
    line-height: 1.55;
  }

  .proof li.now {
    background: linear-gradient(180deg, var(--ceo-grad), var(--p) 75%);
  }

  .proof li.now b {
    color: var(--ac);
  }

  .recent {
    border: 1px solid var(--bd);
    background: var(--bd);
    display: grid;
    gap: 1px;
  }

  .recent-row {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr) 20px;
    gap: 16px;
    align-items: start;
    background: var(--p);
    padding: 16px 18px;
  }

  .recent-row:hover {
    background: var(--p2);
  }

  .recent-row time {
    color: var(--mu);
    font-size: 11px;
    letter-spacing: 0.06em;
    padding-top: 3px;
  }

  .recent-row h3 {
    font-size: 17px;
    line-height: 1.3;
    margin: 0 0 4px;
  }

  .recent-row p {
    color: var(--mu);
    font-size: 12px;
    margin: 0;
    line-height: 1.55;
    max-width: 72ch;
  }

  .recent-row > span {
    color: var(--ac);
    font-size: 14px;
  }

  .beyond {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--bd);
    border: 1px solid var(--bd);
  }

  .beyond a {
    background: var(--p);
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-height: 210px;
  }

  .beyond a:hover {
    background: var(--p2);
  }

  .beyond small {
    color: var(--ac);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .beyond h3 {
    font-size: 19px;
    margin: 0;
  }

  .beyond p {
    color: var(--mu);
    font-size: 12px;
    line-height: 1.55;
    margin: 0;
  }

  .beyond a > span {
    color: var(--tx);
    font-size: 12px;
    margin-top: auto;
  }

  .legacy-anchor {
    display: block;
    scroll-margin-top: 70px;
  }

  .about-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    border-top: 1px solid var(--bd);
    margin-top: 54px;
    padding-top: 24px;
  }

  .about-cta h2 {
    font-size: 24px;
    margin: 0 0 8px;
  }

  .about-cta p {
    color: var(--mu);
    font-size: 13px;
    max-width: 64ch;
    margin: 0;
  }

  .av {
    --av: url("/images/profile/linsaftw.webp");
  }

  @media (max-width: 900px) {
    .proof {
      grid-template-columns: repeat(3, 1fr);
    }

    .beyond {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 760px) {
    .proof {
      grid-template-columns: 1fr 1fr;
    }

    .recent-row {
      grid-template-columns: 1fr;
      gap: 6px;
    }

    .recent-row > span {
      display: none;
    }

    .about-cta {
      align-items: flex-start;
    }
  }
</style>
