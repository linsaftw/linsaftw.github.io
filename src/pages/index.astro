---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { homeGraph } from "../components/seo/JsonLd.astro";
import HomeHero from "../components/home/HomeHero.astro";
import ProofStrip from "../components/home/ProofStrip.astro";
import FlameWmShowcase from "../components/home/FlameWmShowcase.astro";
import ProjectFeature from "../components/home/ProjectFeature.astro";
import Highlights from "../components/home/Highlights.astro";
import SkillsMatrix from "../components/home/SkillsMatrix.astro";
import ProjectLessons from "../components/home/ProjectLessons.astro";

import {
  identity,
  identityRow,
  homeDescription,
  homeH1,
  homeH1Accent,
} from "../data/identity";
import { links, postPath, routes, SITE_URL, workPath } from "../data/links";
import { caseStudyProjects, projectById, projects } from "../data/projects";
import { timeline } from "../data/timeline";

const title = "LinsaFTW — Minecraft Infrastructure Developer";
const site = Astro.site ?? new URL(SITE_URL);
const jsonLd = homeGraph(site, { name: title, description: homeDescription });

const h1Lead = homeH1.slice(0, homeH1.length - homeH1Accent.length);
const homeLead =
  "I build server software, anti-exploit and anti-bot security, a Linux window manager, games and AI tools. Founder of " +
  `${identity.founderOf}, coding since ${identity.codingSince}.`;

const selectedIds = ["exploitfixer", "flamecord", "veloflame", "fairplay"] as const;
const selected = selectedIds
  .map((id) => projectById(id))
  .filter((project): project is NonNullable<typeof project> => Boolean(project));
const flamewm = projectById("flamewm");

const alsoShipped = [
  "ffaa-zombies",
  "entitylimiter",
  "redstonelimiter",
  "flamespawners",
  "authmepremium",
  "ark-ai",
  "faus-legal",
]
  .map((id) => projectById(id))
  .filter((project): project is NonNullable<typeof project> => Boolean(project));

const articles = (await getCollection("articles"))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const recent = articles.slice(0, 4).map((entry) => {
  const slug = /^\/posts\/(.+)\.html$/.exec(entry.data.canonicalPath)?.[1];
  if (!slug) throw new Error(`bad canonicalPath: ${entry.data.canonicalPath}`);
  return {
    title: entry.data.title,
    description: entry.data.description,
    href: postPath(slug),
    date: entry.data.publishedAt.toISOString().slice(0, 10),
  };
});

// Every number below is derived from repo content at build time.
const publicProducts = projects.filter((p) => p.caseStudy?.availability === "public").length;
const stats = [
  { value: String(new Date().getFullYear() - identity.codingSince), label: `years writing code, since ${identity.codingSince}` },
  { value: String(caseStudyProjects.length), label: "case studies with architecture notes" },
  { value: String(publicProducts), label: "public products you can run or download" },
  { value: String(articles.length), label: "technical articles, written from source" },
];

const skillGroups = [
  { title: "Languages", items: ["Java for Bukkit, Paper and Folia plugins", "TypeScript for Next.js and Node services", "Rust for the FlameWM desktop", "HTML and CSS compiled to native rendering", "JavaScript for Astro and browser games"] },
  { title: "Minecraft infrastructure", items: ["Paper and Folia threading", "BungeeCord, Waterfall and Velocity proxies", "Packet protocols with PacketEvents and ProtocolLib", "Limbo verification before backend login", "Entity and redstone budgets"] },
  { title: "Security", items: ["Packet validation before decode", "Anti-bot admission control", "Decompression and frame-size limits", "Fail-closed authentication bridges", "Proxy trust boundaries and firewalls"] },
  { title: "AI and agents", items: ["OpenAI-compatible provider APIs", "Streaming responses without a fake stream", "Bounded agent work", "Model evaluation with a stated method", "ML workflows for combat anticheat"] },
  { title: "X11 and native", items: ["X11 window management", "Experimental Wayland compositing", "Compiled shell with no web runtime", "Workspace state with one owner", "Profiling and tick-budget tuning"] },
  { title: "Web and data", items: ["Next.js, React and Astro", "Node 24 services", "MongoDB collections", "Static content collections", "Source-backed technical writing"] },
];

const lessons = [
  {
    name: "ExploitFixer",
    href: workPath("exploitfixer"),
    lesson: "Reject bad input before you decode it. The cheapest check runs first, before the server builds objects from hostile bytes.",
  },
  {
    name: "FlameCord",
    href: workPath("flamecord"),
    lesson: "Verify at the proxy so bot sessions never reach a game server. A backend should only see traffic that has already passed.",
  },
  {
    name: "VeloFlame",
    href: workPath("veloflame"),
    lesson: "Budgets belong to protocol states. A handshake limit and a play-state limit are not the same number, so one default cannot fit both.",
  },
  {
    name: "FairPlay",
    href: workPath("fairplay"),
    lesson: "Deduplicate events before you act on them. Two listeners applying the same compensation twice is an easy bug to ship.",
  },
  {
    name: "FlameWM",
    href: workPath("flamewm"),
    lesson: "Give shared state one owner. When the panel and the window manager each track the active desktop, they drift apart.",
  },
];

const highlights = [
  {
    title: "Architecture",
    items: [
      { title: "Modules, not a pile of listeners", project: "ExploitFixer", href: workPath("exploitfixer"), note: "Each check is a named module with its own YAML. Operators tune one without a rebuild." },
      { title: "Two bridges, not a fallback chain", project: "AuthMePremium", href: workPath("authmepremium"), note: "A companion plugin path and a Velocity-native session path, each with its own trust setup." },
      { title: "Rust crates with hard boundaries", project: "FlameWM", href: workPath("flamewm"), note: "Pure models stay independent of X11 and Wayland, so they can be tested without a display server." },
    ],
  },
  {
    title: "Performance",
    items: [
      { title: "Early limits at the frame layer", project: "VeloFlame", href: workPath("veloflame"), note: "Packets are validated before they become objects. Decompression checks the claimed and the inflated size." },
      { title: "Batched production", project: "FlameSpawners", href: workPath("flamespawners"), note: "A 20-tick dispatcher handles a bounded number of spawners per pass, so a large farm cannot take over the tick." },
      { title: "Record at every scope", project: "RedstoneLimiter", href: workPath("redstonelimiter"), note: "A blocked parent scope returns early, so the cheap check runs before any further work." },
    ],
  },
  {
    title: "Security",
    items: [
      { title: "Validate before decode", project: "ExploitFixer", href: workPath("exploitfixer"), note: "Oversized or malformed frames are cancelled before a semantic packet is built." },
      { title: "Ordered admission checks", project: "FlameCord", href: workPath("flamecord"), note: "Login checks run in a fixed sequence, and any check can disconnect before a backend sees the connection." },
      { title: "Fail closed on bad configuration", project: "AuthMePremium", href: workPath("authmepremium"), note: "A blank secret or invalid retry value disables the bridge with a warning. The secret is never logged." },
    ],
  },
];

const beyond = [
  {
    eyebrow: "Game",
    title: "FFAA Zombies",
    text: "Browser-first co-op survival with large enemy counts, classes and custom maps.",
    href: workPath("ffaa-zombies"),
    link: "Read the case study",
  },
  {
    eyebrow: "AI",
    title: "ARK AI + FAUS Legal",
    text: "A canonical AI platform and a focused Argentine legal-research workspace.",
    href: workPath("ark-ai"),
    link: "Open the ARK AI case study",
  },
  {
    eyebrow: "Experiments",
    title: "FlameMC + Apex",
    text: "Unpublished local experiments in asynchronous Paper work and anti-ESP detection.",
    href: routes.experiments,
    link: "See the experiments",
  },
] as const;
---

<BaseLayout
  title={title}
  description={homeDescription}
  canonicalPath={routes.home}
  ogType="website"
  jsonLd={jsonLd}
  ogImage="/images/og/home.webp"
>
  <div class="w">
    <HomeHero identityRow={identityRow} lead={homeLead} h1Lead={h1Lead} h1Accent={homeH1Accent} />

    <ProofStrip stats={stats} />

    <div class="sh" id="build">
      <h2>Selected work</h2>
      <span class="sh-right">
        <span>Evidence first</span>
        <a class="sh-all" href={routes.work}>All case studies &#8594;</a>
      </span>
    </div>

    {flamewm && <FlameWmShowcase project={flamewm} />}

    <div class="pl feat" data-reveal>
      {selected.map((project) => <ProjectFeature project={project} />)}
    </div>

    <div class="also">
      <small>Also shipped</small>
      <div>
        {
          alsoShipped.map((project) => (
            <a href={workPath(project.id)}>
              {project.name} <span aria-hidden="true">&#8594;</span>
            </a>
          ))
        }
        <a href={links.arkflamePlugins} target="_blank" rel="noopener noreferrer">
          Full ArkFlame catalog &#8599;
        </a>
      </div>
    </div>

    <div class="sh" id="highlights">
      <h2>Interview-ready decisions</h2>
      <span class="sh-right">
        <span>Architecture · performance · security</span>
      </span>
    </div>
    <Highlights groups={highlights} />

    <div class="sh" id="skills">
      <h2>Skills</h2>
      <span class="sh-right">
        <span>Grouped by where I use them</span>
      </span>
    </div>
    <div data-reveal>
      <SkillsMatrix groups={skillGroups} />
    </div>

    <div class="sh" id="lessons">
      <h2>What each project taught me</h2>
      <span class="sh-right">
        <span>Lessons, not feature lists</span>
      </span>
    </div>
    <ProjectLessons items={lessons} />

    <span id="how" class="legacy-anchor" aria-hidden="true"></span>
    <div class="sh" id="proof">
      <h2>Track record</h2>
      <span class="sh-right">
        <span>Selected milestones</span>
        <a class="sh-all" href={routes.about}>About the work &#8594;</a>
      </span>
    </div>
    <ol class="proof" id="timeline" data-reveal>
      {
        timeline.map((item, index) => (
          <li class={index === timeline.length - 1 ? "now" : undefined}>
            <b>{item.year}</b>
            <span>{item.text}</span>
          </li>
        ))
      }
    </ol>

    <div class="sh" id="writing">
      <h2>Recent writing</h2>
      <span class="sh-right">
        <span>Source-backed notes</span>
        <a class="sh-all" href={routes.articles}>All articles &#8594;</a>
      </span>
    </div>
    <div class="recent" data-reveal>
      {
        recent.map((article) => (
          <a class="recent-row" href={article.href}>
            <time datetime={article.date}>{article.date}</time>
            <div>
              <h3>{article.title}</h3>
              <p>{article.description}</p>
            </div>
            <span aria-hidden="true">&#8594;</span>
          </a>
        ))
      }
    </div>

    <span id="games" class="legacy-anchor" aria-hidden="true"></span>
    <span id="ai" class="legacy-anchor" aria-hidden="true"></span>
    <span id="lab" class="legacy-anchor" aria-hidden="true"></span>
    <div class="sh" id="beyond">
      <h2>Beyond Minecraft</h2>
      <span class="sh-right">
        <span>Games, AI and experiments</span>
      </span>
    </div>
    <div class="beyond" data-reveal>
      {
        beyond.map((item) => (
          <a href={item.href}>
            <small>{item.eyebrow}</small>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            <span>{item.link} &#8594;</span>
          </a>
        ))
      }
    </div>

    <div class="about-cta">
      <div>
        <h2>Want the technical detail?</h2>
        <p>
          Start with the case studies, then read the full story. Each one explains the
          decisions behind the product, not just the feature list.
        </p>
      </div>
      <div class="cta-actions">
        <a class="chip hot" href={links.linkedin} target="_blank" rel="noopener noreferrer">
          Contact me on LinkedIn &#8599;
        </a>
        <a class="chip" href={routes.about}>Read the full story</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .feat {
    margin-top: 18px;
  }

  .also {
    border: 1px solid var(--bd);
    background: var(--p);
    padding: 16px 18px;
    margin-top: 14px;
    display: flex;
    gap: 16px;
    align-items: baseline;
    flex-wrap: wrap;
  }

  .also small {
    color: var(--ac);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .also div {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
  }

  .also a {
    color: var(--mu);
    font-size: 12px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .also a:hover {
    color: var(--ac);
  }

  .also a span {
    color: var(--ac);
  }

  .proof {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    border: 1px solid var(--bd);
    background: var(--bd);
    gap: 1px;
  }

  .proof li {
    background: var(--p);
    padding: 16px 14px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-height: 126px;
  }

  .proof li b {
    color: var(--tx);
    font-size: 18px;
  }

  .proof li span {
    color: var(--mu);
    font-size: 11px;
    line-height: 1.55;
  }

  .proof li.now {
    background: linear-gradient(180deg, var(--ceo-grad), var(--p) 75%);
  }

  .proof li.now b {
    color: var(--ac);
  }

  .recent {
    border: 1px solid var(--bd);
    background: var(--bd);
    display: grid;
    gap: 1px;
  }

  .recent-row {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr) 20px;
    gap: 16px;
    align-items: start;
    background: var(--p);
    padding: 16px 18px;
  }

  .recent-row:hover {
    background: var(--p2);
  }

  .recent-row time {
    color: var(--mu);
    font-size: 11px;
    letter-spacing: 0.06em;
    padding-top: 3px;
  }

  .recent-row h3 {
    font-size: 17px;
    line-height: 1.3;
    margin: 0 0 4px;
  }

  .recent-row p {
    color: var(--mu);
    font-size: 12px;
    margin: 0;
    line-height: 1.55;
    max-width: 72ch;
  }

  .recent-row > span {
    color: var(--ac);
    font-size: 14px;
  }

  .beyond {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--bd);
    border: 1px solid var(--bd);
  }

  .beyond a {
    background: var(--p);
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-height: 210px;
  }

  .beyond a:hover {
    background: var(--p2);
  }

  .beyond small {
    color: var(--ac);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .beyond h3 {
    font-size: 19px;
    margin: 0;
  }

  .beyond p {
    color: var(--mu);
    font-size: 12px;
    line-height: 1.55;
    margin: 0;
  }

  .beyond a > span {
    color: var(--tx);
    font-size: 12px;
    margin-top: auto;
  }

  .legacy-anchor {
    display: block;
    scroll-margin-top: 70px;
  }

  .about-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    border-top: 1px solid var(--bd);
    margin-top: 64px;
    padding-top: 28px;
  }

  .about-cta h2 {
    font-size: 24px;
    margin: 0 0 8px;
  }

  .about-cta p {
    color: var(--mu);
    font-size: 13px;
    max-width: 64ch;
    margin: 0;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  @media (max-width: 900px) {
    .proof {
      grid-template-columns: repeat(3, 1fr);
    }

    .beyond {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 760px) {
    .proof {
      grid-template-columns: 1fr 1fr;
    }

    .recent-row {
      grid-template-columns: 1fr;
      gap: 6px;
    }

    .recent-row > span {
      display: none;
    }

    .about-cta {
      align-items: flex-start;
    }
  }
</style>
