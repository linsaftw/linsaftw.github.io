---
export interface Highlight {
  title: string;
  project: string;
  href: string;
  note: string;
}

export interface HighlightGroup {
  title: string;
  items: readonly Highlight[];
}

export interface Props {
  groups: readonly HighlightGroup[];
}

const { groups } = Astro.props;
---

<div class="highlights">
  {
    groups.map((group) => (
      <section class="hl-group" aria-labelledby={`hl-${group.title.toLowerCase()}`}>
        <h3 id={`hl-${group.title.toLowerCase()}`}>{group.title}</h3>
        <ul>
          {group.items.map((item) => (
            <li>
              <a class="hl-link" href={item.href}>
                <small>{item.project}</small>
                <strong>{item.title}</strong>
              </a>
              <p>{item.note}</p>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

<style>
  .highlights {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--bd);
    border: 1px solid var(--bd);
  }

  .hl-group {
    background: var(--p);
    padding: var(--space-5);
  }

  .hl-group h3 {
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--mu);
    font-weight: 700;
    margin: 0 0 16px;
  }

  .hl-group ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 18px;
  }

  .hl-link {
    display: grid;
    gap: 2px;
    min-height: 44px;
    align-content: center;
  }

  .hl-link small {
    color: var(--ac);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .hl-link strong {
    color: var(--tx);
    font-size: 15px;
    line-height: 1.3;
  }

  .hl-link:hover strong {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .hl-group p {
    margin: 6px 0 0;
    color: var(--mu);
    font-size: 13px;
    line-height: 1.55;
  }

  @media (max-width: 900px) {
    .highlights {
      grid-template-columns: 1fr;
    }
  }
</style>
