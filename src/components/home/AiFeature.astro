---
import { routes } from "../../data/links";
import { aiProjects } from "../../data/projects";
import ProjectFeature from "./ProjectFeature.astro";

/**
 * C16 `#ai` — ARK AI (with artwork) and FAUS Legal (the POC shipped it imageless;
 * that stays). C5: FAUS carries its own disclaimer that it does not replace a
 * licensed lawyer, and C3 fixes its CTA to the real faus.arkflame.com host.
 */
const [arkAi, faus] = aiProjects;
---

<div class="pl">
  {arkAi && <ProjectFeature project={arkAi} />}
  {faus && <ProjectFeature project={faus} note={faus.disclaimer} showImage={false} />}
  <a class="pc" href={routes.guide}>
    <div class="t">
      <small>Guide</small>
      <h3>How I set up AI coding agents</h3>
      <p>Skills, AGENTS.md, harnesses, subscriptions, model choice and MCP servers.</p>
      <span class="l">Read the guide &#8594;</span>
    </div>
  </a>
</div>
