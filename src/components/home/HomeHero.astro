---
import TerminalBlock from "./TerminalBlock.astro";
import { links } from "../../data/links";

export interface Props {
  identityRow: string;
  lead: string;
  h1Lead: string;
  h1Accent: string;
}

const { identityRow, lead, h1Lead, h1Accent } = Astro.props;
---

<section class="home-hero" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow">{identityRow}</p>
    <h1 id="hero-title">{h1Lead}<em>{h1Accent}</em></h1>
    <p class="lead">{lead}</p>
    <div class="hero-actions">
      <a class="hero-btn hero-btn-primary" href={links.linkedin} target="_blank" rel="noopener noreferrer">
        LinkedIn <span aria-hidden="true">&#8599;</span>
      </a>
      <a class="hero-btn" href={links.github} target="_blank" rel="noopener noreferrer">
        GitHub <span aria-hidden="true">&#8599;</span>
      </a>
      <a class="hero-btn" href="#build">View projects <span aria-hidden="true">&#8595;</span></a>
    </div>
  </div>
  <div class="hero-term">
    <TerminalBlock />
  </div>
</section>

<style>
  .home-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: 40px;
    align-items: center;
    padding: 48px 0 8px;
  }

  .eyebrow {
    margin: 0 0 18px;
    color: var(--mu);
    font-size: 12px;
    letter-spacing: 0.08em;
    overflow-wrap: anywhere;
  }

  h1 {
    font-size: clamp(2.1rem, 5.4vw, 3.7rem);
    line-height: 1.04;
    letter-spacing: -0.02em;
    margin: 0 0 22px;
    max-width: 16ch;
  }

  h1 em {
    font-style: normal;
    color: var(--ac);
  }

  .lead {
    font-size: 15px;
    color: var(--copy);
    max-width: 58ch;
    margin: 0 0 28px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .hero-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 10px 16px;
    border: 1px solid var(--bd);
    background: var(--p);
    color: var(--tx);
    font-size: 13px;
    font-weight: 600;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .hero-btn span {
    color: var(--ac);
  }

  .hero-btn:hover {
    border-color: var(--ac);
    background: var(--p2);
  }

  .hero-btn-primary {
    background: var(--ac);
    border-color: var(--ac);
    color: var(--bg);
  }

  .hero-btn-primary span {
    color: var(--bg);
  }

  .hero-btn-primary:hover {
    background: var(--tx);
    border-color: var(--tx);
  }

  .hero-term {
    min-width: 0;
    max-width: 100%;
  }

  @media (max-width: 900px) {
    .home-hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
      padding-top: 32px;
    }
  }

  @media (max-width: 360px) {
    .hero-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
