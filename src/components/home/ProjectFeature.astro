---
import type { Project } from "../../data/projects";
import { workPath } from "../../data/links";

export interface Props {
  project: Project;
  /** Explicit CTA text. Defaults to the internal case study. */
  cta?: string;
  /** Extra honest line rendered under the description (e.g. a disclaimer). */
  note?: string;
  /** Set false for products shipped without artwork. */
  showImage?: boolean;
}

const { project, cta, note, showImage = true } = Astro.props;

/**
 * Exact pixel dimensions and alt text per `public/images/README.md`.
 * Nothing here invents an aspect ratio.
 */
const artwork: Record<string, { width: number; height: number; alt: string }> = {
  "exploitfixer": { width: 720, height: 360, alt: "ExploitFixer plugin artwork" },
  "flamecord": { width: 720, height: 405, alt: "FlameCord plugin artwork" },
  "veloflame": { width: 720, height: 405, alt: "VeloFlame plugin artwork" },
  "fairplay": { width: 720, height: 360, alt: "FairPlay plugin artwork" },
  "ark-ai": { width: 720, height: 378, alt: "ARK AI artwork" },
  "ffaa-zombies": { width: 1000, height: 1000, alt: "FFAA Zombies gameplay screenshot" },
  "flamewm": { width: 720, height: 405, alt: "FlameWM desktop screenshot" },
};

// Case studies stay on-site; official downloads are the secondary CTA inside.
const internal = Boolean(project.caseStudy);
const href = internal ? workPath(project.id) : project.url;
const ctaText = cta ?? (internal ? "Read case study →" : "Visit →");
const image = artwork[project.id];
---

<a
  class="pc"
  href={href}
  target={internal ? undefined : "_blank"}
  rel={internal ? undefined : "noopener noreferrer"}
>
  {
    showImage && project.image && image && (
      <img
        src={project.image}
        alt={image.alt}
        width={image.width}
        height={image.height}
        loading="lazy"
        decoding="async"
      />
    )
  }
  <div class="t">
    <small>{project.kind}</small>
    <h3>{project.name}</h3>
    <p>{project.description}</p>
    {note && <p>{note}</p>}
    <span class="l">{ctaText}</span>
  </div>
</a>
