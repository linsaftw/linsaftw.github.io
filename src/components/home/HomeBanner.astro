---
import { bannerCaption } from "../../data/identity";

/**
 * Photo banner restored from the pre-redesign home. The photograph is a CSS
 * background (`--ban`, consumed by `.ban` in app.css), so it has no `<img>`
 * to size. The height is fixed, which keeps the banner from shifting layout.
 */
---

<div class="ban home-banner" role="img" aria-label="LinsaFTW as a toddler typing at a CRT computer">
  <div class="cap">{bannerCaption}<i></i></div>
</div>

<style>
  .home-banner {
    --ban: url("/images/hero/early-computer.webp");
    height: clamp(180px, 26vw, 280px);
    margin: 0 calc(50% - 50vw);
  }
</style>
