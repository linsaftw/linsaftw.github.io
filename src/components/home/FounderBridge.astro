---
import { identity } from "../../data/identity";
import { links } from "../../data/links";
import { projectById } from "../../data/projects";

/**
 * Founder bridge restored from the pre-redesign home. The eyebrow is FOUNDER
 * only: the executive-title claim is not used anywhere on the site.
 */
const org = projectById("arkflame-studios");
const host = new URL(links.arkflame).host.replace(/^www\./, "");
---

<a class="ceo" href={links.arkflame} target="_blank" rel="noopener noreferrer">
  <div>
    <small>FOUNDER</small>
    <h3>{identity.founderOf}</h3>
    <p>{org?.description}</p>
  </div>
  <b>{host} &#8599;</b>
</a>

<style>
  .ceo small {
    display: block;
    color: var(--ac);
    font-size: 11px;
    letter-spacing: 0.22em;
    margin-bottom: 8px;
  }
  .ceo:hover h3 {
    color: var(--ac);
  }
</style>
