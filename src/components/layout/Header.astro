---
import { links, routes } from "../../data/links";

export interface Props {
  /** Canonical path of the current page, e.g. "/work.html" or "/docs/exploitfixer/overview.html". */
  activePath?: string;
}

const { activePath = routes.home } = Astro.props;

type NavItem = { label: string; href: string; match: readonly string[] };

const primary: readonly NavItem[] = [
  { label: "Work", href: routes.work, match: ["/work.html", "/work/"] },
  { label: "Articles", href: routes.articles, match: ["/articles.html", "/posts/"] },
  { label: "Docs", href: routes.docs, match: ["/docs.html", "/docs/"] },
  { label: "About", href: routes.about, match: ["/about.html"] },
];

const secondary: readonly NavItem[] = [
  { label: "Games", href: routes.games, match: ["/games.html"] },
  { label: "AI", href: routes.ai, match: ["/ai.html"] },
  { label: "Experiments", href: routes.experiments, match: ["/experiments.html"] },
  { label: "Press", href: routes.press, match: [routes.press] },
  { label: "Guide", href: routes.guide, match: [routes.guide] },
];

const isCurrent = (item: NavItem): boolean =>
  item.match.some((prefix) =>
    prefix.endsWith("/") ? activePath.startsWith(prefix) : activePath === prefix,
  );
---

<header>
  <div class="w">
    <a class="logo" href={routes.home} aria-label="LinsaFTW home">LinsaFTW</a>

    <details class="nav-drawer" id="nav-drawer">
      <summary class="nav-toggle" aria-controls="nav-drawer-panel">
        <span class="menu-closed">Menu</span>
        <span class="menu-open">Close</span>
      </summary>
      <nav class="nav-drawer-links" id="nav-drawer-panel" aria-label="Primary (compact)">
        {
          primary.map((item) => (
            <a href={item.href} aria-current={isCurrent(item) ? "page" : undefined}>
              {item.label}
            </a>
          ))
        }
        <span class="drawer-label">More</span>
        {
          secondary.map((item) => (
            <a href={item.href} aria-current={isCurrent(item) ? "page" : undefined}>
              {item.label}
            </a>
          ))
        }
        <a href={links.github} target="_blank" rel="noopener noreferrer">GitHub &#8599;</a>
      </nav>
    </details>

    <nav class="nav-links" aria-label="Primary">
      {
        primary.map((item) => (
          <a href={item.href} aria-current={isCurrent(item) ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
      <details class="nav-more">
        <summary>More</summary>
        <div class="nav-more-panel">
          {
            secondary.map((item) => (
              <a href={item.href} aria-current={isCurrent(item) ? "page" : undefined}>
                {item.label}
              </a>
            ))
          }
        </div>
      </details>
      <a class="keep github" href={links.github} target="_blank" rel="noopener noreferrer">
        GitHub &#8599;
      </a>
    </nav>
  </div>
</header>

<script is:inline data-enhance="site">
  (function () {
    var drawer = document.getElementById("nav-drawer");
    var toggle = drawer && drawer.querySelector("summary.nav-toggle");
    /* Desktop "More" disclosure: Escape and outside click close it, returning focus to its summary. */
    var more = document.querySelector("details.nav-more");
    if (more) {
      more.addEventListener("keydown", function (event) {
        if (event.key === "Escape" && more.open) {
          event.preventDefault();
          more.open = false;
          more.querySelector("summary").focus();
        }
      });
      document.addEventListener("pointerdown", function (event) {
        if (more.open && !more.contains(event.target)) more.open = false;
      });
    }
    if (!drawer || !toggle) return;
    var mq = window.matchMedia("(max-width: 760px)");
    var panel = document.getElementById("nav-drawer-panel");
    /* Keep aria-expanded in sync; lock page scroll only while the mobile drawer is open. */
    var sync = function () {
      toggle.setAttribute("aria-expanded", String(drawer.open));
      document.documentElement.classList.toggle("nav-locked", drawer.open && mq.matches);
    };
    var close = function (returnFocus) {
      if (!drawer.open) return;
      drawer.open = false;
      if (returnFocus) toggle.focus();
    };
    sync();
    drawer.addEventListener("toggle", sync);
    drawer.addEventListener("keydown", function (event) {
      if (!drawer.open) return;
      if (event.key === "Escape") {
        event.preventDefault();
        close(true);
        return;
      }
      /* Focus trap: Tab wraps between the toggle and the drawer links. */
      if (event.key !== "Tab" || !mq.matches) return;
      var links = panel.querySelectorAll("a[href]");
      var last = links[links.length - 1];
      if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        toggle.focus();
      } else if (event.shiftKey && document.activeElement === toggle) {
        event.preventDefault();
        last.focus();
      }
    });
    /* Pointer outside the open drawer closes it without moving focus. */
    document.addEventListener("pointerdown", function (event) {
      if (drawer.open && !drawer.contains(event.target)) close(false);
    });
    /* Focus leaving the drawer (for example via a click target) closes it too. */
    drawer.addEventListener("focusout", function (event) {
      if (drawer.open && !drawer.contains(event.relatedTarget)) close(false);
    });
    /* Crossing the breakpoint with the drawer open resets it to the desktop nav. */
    mq.addEventListener("change", function () {
      if (!mq.matches) close(false);
      sync();
    });
  })();
</script>

<style>
  summary.nav-toggle,
  summary.nav-more > summary {
    list-style: none;
  }

  summary.nav-toggle::-webkit-details-marker,
  summary.nav-more > summary::-webkit-details-marker {
    display: none;
  }

  summary.nav-toggle::marker,
  summary.nav-more > summary::marker {
    content: "";
  }

  .menu-open {
    display: none;
  }

  .nav-drawer[open] .menu-closed {
    display: none;
  }

  .nav-drawer[open] .menu-open {
    display: inline;
  }

  .nav-more {
    position: relative;
  }

  .nav-more > summary {
    display: flex;
    align-items: center;
    min-height: 44px;
    color: var(--mu);
    font-size: 12px;
    cursor: pointer;
    user-select: none;
  }

  .nav-more > summary:hover,
  .nav-more[open] > summary {
    color: var(--ac);
  }

  .nav-more-panel {
    position: absolute;
    top: calc(100% - 2px);
    right: 0;
    min-width: 176px;
    display: grid;
    background: var(--p);
    border: 1px solid var(--bd);
    padding: var(--space-1);
    box-shadow: var(--elev-2);
  }

  .nav-more-panel a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0 12px;
    border-bottom: 1px solid var(--bd);
  }

  .nav-more-panel a:last-child {
    border-bottom: 0;
  }

  .nav-more-panel a[aria-current="page"] {
    color: var(--ac);
  }

  .drawer-label {
    color: var(--mu-dim);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    padding: 14px 0 4px;
  }

  @media (max-width: 760px) {
    summary.nav-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 76px;
      min-height: 44px;
      padding: 0 14px;
      border: 1px solid var(--bd);
      background: var(--p);
      color: var(--tx);
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      line-height: 1;
      cursor: pointer;
      transition:
        border-color 0.2s ease,
        color 0.2s ease;
    }

    summary.nav-toggle:hover,
    .nav-drawer[open] summary.nav-toggle {
      border-color: var(--ac);
      color: var(--ac);
    }

    .nav-drawer {
      display: block;
      margin-left: auto;
    }

    .nav-more {
      display: none;
    }

    .nav-drawer[open] .nav-drawer-links {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      display: flex;
      flex-direction: column;
      gap: 2px;
      max-height: calc(100dvh - 56px);
      overflow-y: auto;
      padding: 0 var(--gutter) var(--space-4);
      overscroll-behavior: contain;
      background: var(--bg);
      box-shadow: var(--elev-2);
      border-bottom: 1px solid var(--bd);
    }

    .nav-drawer[open] .nav-drawer-links a {
      color: var(--mu);
      font-size: 13px;
      padding: 12px 0;
      border-bottom: 1px solid var(--bd);
    }

    .nav-drawer[open] .nav-drawer-links a[aria-current="page"] {
      color: var(--ac);
    }
  }
</style>
