---
import "../assets/app.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import SeoHead from "../components/seo/SeoHead.astro";
import JsonLd from "../components/seo/JsonLd.astro";
import Enhance from "../components/ui/FilterScript.astro";

export interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  ogType?: "website" | "article";
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  ogImage?: string;
  markdownTwin?: boolean;
  preloadImage?: string;
  articleMeta?: {
    publishedAt?: Date;
    updatedAt?: Date;
    tags?: readonly string[];
  };
}

const {
  title,
  description,
  canonicalPath,
  ogType = "website",
  noindex = false,
  jsonLd = [],
  ogImage = "/images/og/home.webp",
  markdownTwin = false,
  preloadImage,
  articleMeta,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SeoHead
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      ogType={ogType}
      noindex={noindex}
      ogImage={ogImage}
      markdownTwin={markdownTwin}
      preloadImage={preloadImage}
      articleMeta={articleMeta}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header activePath={canonicalPath} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <Enhance />
    {jsonLd.length > 0 && <JsonLd nodes={jsonLd} />}
  </body>
</html>
